<?xml version="1.0" encoding="utf-8"?>
<!--
  Describes the widget to the Android home screen: how big it can be,
  how often it should ask to be refreshed on its own (belt-and-suspenders --
  the app also pushes an update immediately whenever the brain dump text
  changes, via BrainDumpWidgetPlugin), and which layout to draw.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/braindump_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/braindump_widget_description">
</appwidget-provider>
