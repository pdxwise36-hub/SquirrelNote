# --- Supabase (server-side) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude / Anthropic ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# --- Granola (optional) ---
# Personal access token for the Granola API. See README for how to obtain it.
GRANOLA_API_TOKEN=
